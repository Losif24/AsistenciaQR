# Copie este archivo como .env y ajuste lo que necesite.
# Si no existe .env, la aplicacion usa estos mismos valores por defecto.

# Puerto donde escucha el servidor
PORT=4090

# Interfaz de red. 0.0.0.0 permite entrar desde otros equipos de la red local.
HOST=0.0.0.0

# Ruta del archivo SQLite. Relativa a la raiz del proyecto.
DB_FILE=data/asistencia.db

# Zona horaria usada para fechas, horas y reportes.
TZ=America/Bogota

# Clave para firmar las cookies de sesion.
# Si se deja vacia se genera una automatica y se guarda en data/secret.key
SESSION_SECRET=

# Duracion de la sesion en horas
SESSION_HOURS=12

# Nombre de la organizacion que aparece en la interfaz y en los reportes
ORG_NAME=Mi Organizacion
